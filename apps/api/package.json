{
  "name": "@oliver/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/worker.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:migrate:dev": "node scripts/prisma.mjs migrate dev",
    "db:diff": "node scripts/prisma.mjs migrate diff",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "mock:meta": "tsx --env-file-if-exists=../../.env scripts/mock-meta.ts",
    "simulate:webhook": "tsx --env-file-if-exists=../../.env scripts/simulate-webhook.ts",
    "mock:bling": "tsx scripts/mock-bling.ts",
    "sync:bling": "tsx --env-file-if-exists=../../.env scripts/sync-bling.ts",
    "sync:bling:prod": "node dist/scripts/sync-bling.js",
    "mock:claude": "tsx scripts/mock-claude.ts",
    "checklist": "tsx --env-file-if-exists=../../.env scripts/checklist.ts",
    "checklist:prod": "node dist/scripts/checklist.js",
    "db:seed:prod": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.2",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.6",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.5",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
