# ════════════════════════════════════════════════════════════════════
#  Oliver WhatsApp Hub — variáveis de ambiente
#  Copie para ".env" e preencha. NUNCA commite o .env.
#  Itens marcados com [PREENCHER] são obrigatórios para produção.
# ════════════════════════════════════════════════════════════════════

NODE_ENV=production
LOG_LEVEL=info
PORT=3001
HOST=0.0.0.0

# URL pública da API (onde a Meta vai chamar o /webhook). Em teste local use a URL do ngrok.
PUBLIC_BASE_URL=https://SEU-DOMINIO-OU-NGROK            # [PREENCHER]
# URL do painel (Next.js)
PANEL_URL=http://localhost:3000

# HTTPS automático com o Caddy do docker-compose (docker compose --profile https up -d --build).
# Com ele: PUBLIC_BASE_URL e PANEL_URL = https://DOMAIN e COOKIE_SECURE=true.
# DOMAIN=hub.seudominio.com.br
# ACME_EMAIL=voce@seudominio.com.br

# ─── Banco (Postgres) ───────────────────────────────────────────────
# No docker-compose o host é "postgres". Senha: troque em produção.
POSTGRES_PASSWORD=troque-esta-senha                       # [PREENCHER]
DATABASE_URL=postgresql://oliver:troque-esta-senha@postgres:5432/oliver_hub?schema=public

# ─── Filas ──────────────────────────────────────────────────────────
# bullmq = Redis (produção). memory = fila em processo (só para dev/teste sem Redis).
QUEUE_DRIVER=bullmq
REDIS_URL=redis://redis:6379
# true = a API também processa as filas (dispensa o container "worker"). Em produção deixe false.
RUN_WORKERS_IN_API=false

# ─── Segurança ──────────────────────────────────────────────────────
# Chave AES-256-GCM (32 bytes em base64) para criptografar tokens no banco.
# Gere com:  openssl rand -base64 32
#   ou:      node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: se perder/trocar esta chave, os tokens salvos no banco não poderão ser lidos.
ENCRYPTION_KEY=                                           # [PREENCHER]

# ─── Painel ─────────────────────────────────────────────────────────
# Código pedido na tela "Primeiro acesso" (só funciona enquanto não existe usuário).
# Gere com: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
SETUP_TOKEN=                                              # [PREENCHER]
# true quando o painel estiver em HTTPS (produção). false só para http://localhost.
COOKIE_SECURE=true
SESSION_TTL_HOURS=168
LOGIN_RATE_LIMIT=10

# ─── Meta / WhatsApp Cloud API (oficial) ────────────────────────────
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v23.0
# App Secret do App na Meta (Configurações do app > Básico). Valida o X-Hub-Signature-256.
META_APP_SECRET=                                          # [PREENCHER]
# ID do app (developers.facebook.com → seu app → Configurações → Básico). Só para criar template com PDF no cabeçalho (fornecedores).
META_APP_ID=
# Texto livre que você inventa e repete na tela de configuração do webhook da Meta (mín. 8 caracteres).
META_VERIFY_TOKEN=                                        # [PREENCHER]
# Token PERMANENTE de System User (Business Manager > Usuários do sistema), com
# whatsapp_business_messaging + whatsapp_business_management. Usado quando o número não tem token próprio.
META_ACCESS_TOKEN=                                        # [PREENCHER]
# ID da conta WhatsApp Business (WABA) e do número principal
META_WABA_ID=                                             # [PREENCHER]
META_DEFAULT_PHONE_NUMBER_ID=                             # [PREENCHER]
# Template usado pelo botão "Testar envio" quando a janela de 24h está fechada
# (hello_world já vem aprovado em toda WABA nova).
TEST_TEMPLATE_NAME=hello_world
TEST_TEMPLATE_LANGUAGE=en_US

# ─── Bling (API v3) ─────────────────────────────────────────────────
# Crie um app em Bling > Central de Extensões > Área do Integrador > Criar aplicativo.
# Escopos: Produtos, Categorias de produtos, Contatos, Pedidos de venda e Situações (leitura).
# "Link de redirecionamento" do app = BLING_REDIRECT_URI (padrão: PANEL_URL + /api/bling/callback).
BLING_CLIENT_ID=                                          # [PREENCHER]
BLING_CLIENT_SECRET=                                      # [PREENCHER]
# BLING_REDIRECT_URI=https://painel.seudominio.com.br/api/bling/callback
BLING_API_BASE_URL=https://api.bling.com.br/Api/v3
BLING_OAUTH_BASE_URL=https://www.bling.com.br/Api/v3/oauth
# De quanto em quanto tempo o catálogo é atualizado (minutos)
BLING_SYNC_INTERVAL_MINUTES=30
# Intervalo mínimo entre chamadas (o Bling aceita 3 por segundo)
BLING_MIN_INTERVAL_MS=350

# ─── Bot de IA ──────────────────────────────────────────────────────
# ai = bot Claude | echo = resposta de teste fixa | off = só registra (atendimento 100% humano)
BOT_MODE=ai
# Chave da Anthropic (console.anthropic.com). Também pode ser salva pelo painel (Bot de IA → Configurações),
# onde fica criptografada no banco e tem prioridade sobre esta.
ANTHROPIC_API_KEY=                                        # [PREENCHER]
ANTHROPIC_MODEL=claude-sonnet-5-5
# low = responde mais rápido (indicado para conversa) | medium | high
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=8000
# Só para testar sem chave, com o Claude simulado (npm run mock:claude). Deixe vazio em produção.
# ANTHROPIC_BASE_URL=http://localhost:4030
# Espera (ms) antes de responder, para juntar mensagens que o cliente manda em sequência
BOT_DEBOUNCE_MS=2500
# Caminho da base de conhecimento inicial (padrão: knowledge/oliver.md na raiz do projeto)
# KNOWLEDGE_FILE=/app/knowledge/oliver.md

# ─── Campanhas ──────────────────────────────────────────────────────
# Intervalo da rodada do motor de envio (ms). O ritmo de cada número (mensagens/min) é ajustado em Números.
CAMPAIGN_TICK_MS=2000

# ─── Avisos de pedido ───────────────────────────────────────────────
# De quanto em quanto tempo (segundos) o hub pergunta ao Bling quais pedidos mudaram de situação.
ORDERS_POLL_SECONDS=120

# ─── Limites ────────────────────────────────────────────────────────
WEBHOOK_RATE_LIMIT_PER_MINUTE=1200
TZ_BUSINESS=America/Sao_Paulo
